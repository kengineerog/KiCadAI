(footprint "resistor"
  (layer "F.Cu")
  (descr "R_0603_1608Metric BGA 1x2")
  (attr smd)
  (pad "A1" smd circle (at 0.0 0.0 0) (size 1.4400000000000002 1.4400000000000002) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "A2" smd circle (at 1.6 0.0 0) (size 1.4400000000000002 1.4400000000000002) (layers "F.Cu" "F.Paste" "F.Mask"))
  (model "${KICAD_MODELS}/resistor.step"
    (at (xyz 0 0 0))
    (scale (xyz 1 1 1)))
)
